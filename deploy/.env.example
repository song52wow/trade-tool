# 部署环境变量。复制成同目录的 .env 后按目标机情况改：
#
#   cp .env.example .env
#
# .env 已被仓库根 .gitignore 忽略，不要提交。本文件是入库的说明。
# compose 会自动读同目录 .env 做变量插值，四个容器则通过 env_file 拿到同一份。

# 镜像标签。与 `docker build -t` 用的标签必须一致；镜像靠 save/load 搬运，
# 目标机上不存在时服务会直接起不来（pull_policy: never）。
TRADE_TOOL_IMAGE=trade-tool:deploy

# PostgreSQL。密码只走环境变量，配置文件里写 database.password 会被直接拒绝。
# 改这里即同时改数据库与应用，两侧同源。
TRADE_TOOL_PG_USER=trade
TRADE_TOOL_PG_PASSWORD=change-me-before-first-boot
TRADE_TOOL_PG_DATABASE=trade_tool
TRADE_TOOL_PG_PORT=5432
# 数据库端口绑到宿主机哪个地址。0.0.0.0 = 局域网可达；改成 127.0.0.1 只本机可用。
TRADE_TOOL_PG_BIND=0.0.0.0

# 控制面端口。容器内监听与宿主机映射用同一个值。
TRADE_TOOL_WEB_PORT=8787

# ---- 代理（可选；留空即直连）------------------------------------------------
#
# 只给这三个容器用的**显式代理**，不动宿主机路由。填了就走，不填就直连。
# 形如 http://用户名:密码@主机:端口 —— 用户名/密码来自代理服务自身的认证。
# HTTPS_PROXY 与 HTTP_PROXY 通常填同一个 http:// 地址（混合端口同时支持 HTTP 与 SOCKS）。
TRADE_TOOL_HTTP_PROXY=
TRADE_TOOL_HTTPS_PROXY=
# 内网与数据库直连。postgres 是 compose 里的服务名，必须留在 NO_PROXY 里：
# 容器间连接绕一圈代理既慢又可能在代理抖动时连不上库。
TRADE_TOOL_NO_PROXY=postgres,127.0.0.1,localhost
# Node 侧（私有 REST 接口）默认**不读**代理环境变量，必须显式开这个 flag。
# 实测 Node 22.23 支持；不设置时 fetch 会直连，而 Python 侧照常走代理——
# 这种「一半通一半不通」最难查，所以两者要么都开要么都关。
TRADE_TOOL_NODE_OPTIONS=--use-env-proxy

# 止盈止损（executor）用。**这两项能下真实订单**，因此：
#   * 只在目标机的 .env 里填，不要提交；
#   * API key 只开「交易」权限，不要开「提现」；
#   * executor 服务本身在 compose profile 里，不显式开就不会启动；
#   * 还要在 config/trade-tool.config.json 里把 executor.enabled 改成 true。
TRADE_TOOL_BINANCE_API_KEY=
TRADE_TOOL_BINANCE_API_SECRET=

# Demo 用户数据流的**基址**（不带 /private/ws?listenKey=，那一段由代码拼）。
#
# 部署配置固定是 `executor.environment = "demo"`（本仓库只跑 Demo Trading，不接主网），
# 而 demo 环境的 WS 地址**不内置代码默认值**——缺它，三个服务（web / sync / executor）
# 都会以 `CONFIG_INVALID: exchange.environment = demo 但没有给 Demo 用户数据流地址`
# 启动失败。2026-10-22 部署实测踩到。
#
# 核对日期 2026-10-15，官方 USDⓈ-M Futures General Info 的 "Testnet API Information"：
#   REST  https://demo-fapi.binance.com（代码里的常量，不用配）
#   WS    wss://demo-fstream.binance.com
# 写 https:// 也行（代码会归一成 wss://）。
TRADE_TOOL_BINANCE_DEMO_STREAM_URL=https://demo-fstream.binance.com

# 凭据静态加密的主密钥（v0.5.0），必须是 32 字节（64 位 hex 或 44 位 base64），
# 长度不对会直接拒绝启动。生成方式：openssl rand -hex 32
# 丢了就解不开库里的密文，只能重新在控制面录入。
TRADE_TOOL_SECRET_KEY=

# ---- 飞书通知（v0.8.0）------------------------------------------------------
#
# 目标机上的 executor 会把对账发现的差异（尤其是「仓位当前没有止损保护」）推到飞书群。
# 地址在飞书群里「设置 → 群机器人 → 添加机器人 → 自定义机器人」拿，形如
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
#
# ⚠️ webhook 地址就是凭据（拿到就能往群里发消息），只放在目标机的 .env 里，不要提交。
#   还要在 config/trade-tool.config.json 里写 "notify": { "enabled": true } 才会推送；
#   开了却没填地址，executor 会**启动失败**（不静默跳过）。
#
# 💡 也可以不填这两个变量：目标机的控制面「设置」页里有一块「飞书通知」，直接在那儿
#    填地址即可（密文落库，页面只显示末 4 位）。控制面录入的那一份**优先于**这里；
#    两种方式只用一种，别两边都填。
#
# 机器人的「安全设置」选了「签名校验」才需要第二个变量，没选就留空。
TRADE_TOOL_FEISHU_WEBHOOK_URL=
TRADE_TOOL_FEISHU_WEBHOOK_SECRET=