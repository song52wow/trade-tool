# 项目级环境变量模板。复制成同目录的 .env 后按本机情况改：
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不要提交；本文件是入库的说明。
#
# 两个入口（apps/cli、apps/sync）启动时自动加载仓库根的 .env，
# 因此日常使用不需要在 shell 里 export。已存在的环境变量不会被 .env 覆盖，
# CI 与生产注入的值始终优先。

# 工作根目录。配置文件 trade-tool.config.json、行情缓存 data/cache、
# 原始数据 data/raw、元数据 data/meta、回测报告 reports/ 全部相对它解析。
# 必须写**绝对路径**：相对路径是按进程 cwd 解析的，而
# `pnpm --filter … start` 的 cwd 是 apps/cli，直跑 dist 又是仓库根，两者会解析到不同位置。
TRADE_TOOL_HOME=/absolute/path/to/trade-tool/.local

# PostgreSQL 密码。只经环境变量注入，配置文件里写 database.password 会被直接拒绝。
# 与 compose 服务里的 POSTGRES_PASSWORD 同源，改这里即可同时改数据库与应用。
TRADE_TOOL_PG_PASSWORD=trade

# 控制面（apps/web）监听地址与端口。只绑 127.0.0.1 则仅本机可访问；
# 改成 0.0.0.0 会让局域网内任何设备都能打开——页面能触发全量拉读、也能读库里的数据，
# 按需取舍。
TRADE_TOOL_WEB_HOST=0.0.0.0
TRADE_TOOL_WEB_PORT=8787

# 以下几项一般不用改：留空即用 compose 里的默认值（trade / trade_tool / 5432），
# 与 packages/core 的 databaseSchema 默认值一致。
# TRADE_TOOL_PG_HOST=127.0.0.1
# TRADE_TOOL_PG_PORT=5432
# TRADE_TOOL_PG_USER=trade
# TRADE_TOOL_PG_DATABASE=trade_tool
