{
  "name": "@trade-tool/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "控制面：HTTP API + 前端看板（N-7）",
  "main": "./dist/main.js",
  "bin": {
    "trade-tool-web": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "dev": "tsx watch src/main.ts",
    "dev:ui": "vite",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@trade-tool/core": "workspace:*",
    "@trade-tool/data": "workspace:*",
    "@trade-tool/sync": "workspace:*",
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@trade-tool/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
