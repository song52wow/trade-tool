{
  "name": "@trade-tool/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "分析师 Agent 与交易员 Agent 的常驻编排进程",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "trade-tool-agent": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trade-tool/core": "workspace:*",
    "@trade-tool/data": "workspace:*"
  },
  "devDependencies": {
    "@trade-tool/tsconfig": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
