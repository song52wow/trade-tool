# ---- Node / pnpm / Turborepo ----
node_modules/
dist/
.turbo/
*.tsbuildinfo
.pnpm-store/

# ---- Python / uv ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
python/dist/

# ---- 运行时产物 ----
.env
.env.*
!.env.example
# TRADE_TOOL_HOME 指向的工作根目录（见 .env.example）：配置文件与各类数据都落在这里。
# 整段忽略，避免 trade-tool.config.json 这类本机状态混进 git status。
.local/
# 注意：`data/cache/`（不带前导 **/）会被 git 视为相对仓库根锚定，
# 匹配不到 `apps/cli/data/cache` 这类嵌套位置。缓存目录可由代码随时重新生成，
# 因此这里用 `**/` 显式覆盖任意层级。
**/data/cache/
**/data/raw/
**/data/meta/
**/reports/
logs/
*.log

# deploy/build-image.sh 的本地产物（镜像 tar），可能几百 MB，只在搬运时存在。
dist-deploy/
# 本机在仓库内开的 git worktree（工具生成）。它是一个**嵌套仓库**：
# 不忽略的话 `git add -A` 会把里面几百 MB 的源码一起提交，
# `docker build` 的 `COPY . /app` 也会把它拷进构建上下文。
.worktrees/
.DS_Store
.idea/
.vscode/
