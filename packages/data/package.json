{
  "name": "@trade-tool/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "行情数据接入与 Python 侧桥接",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
